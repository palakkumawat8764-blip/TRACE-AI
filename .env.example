# TRACE AI Environment Configuration
# Copy this file to ".env" when you are ready to customize settings or add an API key.

# "mock" = Free offline rule-based report generator (no API key needed)
# "gemini" = Use Google Gemini API (requires GEMINI_API_KEY below)
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anomaly Detection & Correlation Settings
ANOMALY_CONTAMINATION=0.08
CORRELATION_WINDOW_SECONDS=180

# RAG (Technical Manual Search) Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
